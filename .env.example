# .env.example
# Application connection. Use the dedicated unibudget_app role, never the
# Supabase postgres user. Through a Supabase pooler, append the project ref to
# the username (for example unibudget_app.PROJECT_REF).
DATABASE_URL=postgresql://unibudget_app.PROJECT_REF:password@HOST:5432/postgres

# Migration/administrator connection used only by scripts/migrate.mjs.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:password@HOST:5432/postgres

# Password assigned to the unibudget_app role by the migration runner.
APP_DATABASE_PASSWORD=

# Verified TLS. Download the Supabase CA certificate from the project's
# Database Settings and point PGSSLROOTCERT at it locally. ECS instead receives
# the same PEM through the SUPABASE_CA_CERT secret; never disable verification.
PGSSLMODE=verify-full
PGSSLROOTCERT=./certs/supabase-ca.crt

# Node environment (development or production)
NODE_ENV=development
