---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="footer-brand">&copy; {today.getFullYear()} {SITE_TITLE}</p>
		<p class="footer-note">
			Written for university students. General information only, not financial advice.
		</p>
		<nav aria-label="Footer">
			<a href="/blog/">Writing</a>
			<a href="/about/">About</a>
			<a href="/rss.xml">RSS feed</a>
		</nav>
	</div>
</footer>
<style>
	footer {
		margin-top: 3em;
		padding: 2.5em 1em 4em;
		border-top: 1px solid rgb(var(--gray-light));
		background: linear-gradient(rgba(var(--gray-light), 30%), #fff) no-repeat;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.footer-inner {
		display: grid;
		gap: 0.35em;
		max-width: 960px;
		margin: 0 auto;
	}
	.footer-brand {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-weight: 600;
	}
	.footer-note {
		margin: 0;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
		margin-top: 0.75em;
	}
	nav a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
</style>
