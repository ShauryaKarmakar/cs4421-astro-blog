<div class="workspace-account-bar">
  <div class="workspace-account" role="group" aria-label="Signed-in account">
    <span class="account-avatar" aria-hidden="true">U</span>
    <div class="account-copy">
      <span class="account-label">Signed in as</span>
      <span
        id="workspace-account-email"
        class="account-email"
        title="Loading account details"
        aria-label="Loading account details"
      >Loading account…</span>
    </div>
    <form id="workspace-signout-form" action="/api/auth/logout" method="POST">
      <button class="signout-button" type="submit" aria-label="Sign out of UniBudget">Sign out</button>
    </form>
  </div>
  <p id="workspace-account-status" class="account-status" role="status" aria-live="polite" hidden></p>
</div>

<script>
  interface UserResponse {
    user?: {
      email?: unknown;
    };
  }

  const emailElement = document.querySelector<HTMLSpanElement>('#workspace-account-email');
  const avatarElement = document.querySelector<HTMLElement>('.workspace-account .account-avatar');
  const statusElement = document.querySelector<HTMLParagraphElement>('#workspace-account-status');
  const signoutForm = document.querySelector<HTMLFormElement>('#workspace-signout-form');
  const signoutButton = signoutForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

  function showStatus(message: string): void {
    if (!statusElement) return;
    statusElement.textContent = message;
    statusElement.hidden = false;
  }

  async function loadAccount(): Promise<void> {
    if (!emailElement) return;

    try {
      const response = await fetch('/api/auth/me', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });

      if (response.status === 401) {
        window.location.assign('/login');
        return;
      }
      if (!response.ok) throw new Error('Account request failed');

      const body = (await response.json()) as UserResponse;
      const email = body.user?.email;
      if (typeof email !== 'string' || email.length === 0) {
        throw new Error('Account email is unavailable');
      }

      emailElement.textContent = email;
      emailElement.title = email;
      emailElement.setAttribute('aria-label', `Signed in as ${email}`);
      if (avatarElement) avatarElement.textContent = email.slice(0, 1).toUpperCase();
    } catch {
      emailElement.textContent = 'Account unavailable';
      emailElement.title = 'Unable to load account details';
      emailElement.setAttribute('aria-label', 'Account details unavailable');
      showStatus('Unable to load account details. Refresh the page to try again.');
    }
  }

  signoutForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!signoutButton) return;

    signoutButton.disabled = true;
    showStatus('Signing out…');

    try {
      const response = await fetch(signoutForm.action, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { Accept: 'application/json' },
      });
      const body = (await response.json()) as { success?: unknown };

      if (!response.ok || body.success !== true) {
        throw new Error('Sign-out request failed');
      }

      window.location.assign('/login');
    } catch {
      signoutButton.disabled = false;
      showStatus('Unable to sign out. Please try again.');
    }
  });

  void loadAccount();
</script>

