---
import BaseHead from '@/components/BaseHead.astro';
import WorkspaceLayout from '@/components/WorkspaceLayout.astro';
import { getCalendarDateInTimeZone, isValidTimeZone } from '@/lib/financialCalculations';
import { pool } from '@/lib/db';
import { isValidBudgetMonth } from '@/lib/budgetCalculations';
import { APP_CURRENCY } from '@/lib/currencyFormatting';

const userId = Astro.locals.userId;
if (!userId) return Astro.redirect('/login', 303);

const profileResult = await pool.query<{ timezone: string | null }>(
  `SELECT timezone
   FROM profiles
   WHERE user_id = $1
   ORDER BY updated_at DESC
   LIMIT 1`,
  [userId],
);
const timeZone = profileResult.rows[0]?.timezone ?? 'UTC';
if (!isValidTimeZone(timeZone)) throw new Error('User profile contains an invalid timezone.');
const today = getCalendarDateInTimeZone(new Date(), timeZone);
const todayMonth = today.slice(0, 7);
const requestedMonth = Astro.url.searchParams.get('month');
const hasInvalidMonth = requestedMonth !== null
  && (!isValidBudgetMonth(requestedMonth) || requestedMonth > todayMonth);
const month = requestedMonth !== null && !hasInvalidMonth ? requestedMonth : todayMonth;
const invalidMonthMessage = hasInvalidMonth
  ? 'That month is unavailable. Showing the current month instead.'
  : '';

function shiftMonth(value: string, amount: number): string | null {
  const [year, monthNumber] = value.split('-').map(Number);
  const index = (year - 1) * 12 + monthNumber - 1 + amount;
  if (index < 0 || index >= 9999 * 12) return null;
  return `${String(Math.floor(index / 12) + 1).padStart(4, '0')}-${String(index % 12 + 1).padStart(2, '0')}`;
}

const previousMonth = shiftMonth(month, -1);
const nextMonth = month < todayMonth ? shiftMonth(month, 1) : null;
const monthEnd = (value: string) => {
  const [year, monthNumber] = value.split('-').map(Number);
  const lastDay = new Date(Date.UTC(year, monthNumber, 0)).getUTCDate();
  return `${value}-${String(lastDay).padStart(2, '0')}`;
};
const reportThroughDate = month < todayMonth ? monthEnd(month) : today;
const displayMonth = new Intl.DateTimeFormat('en', {
  month: 'long',
  timeZone: 'UTC',
  year: 'numeric',
}).format(new Date(`${month}-01T00:00:00Z`));
---

<!doctype html>
<html lang="en" class="workspace-page">
  <head>
    <BaseHead title="Monthly budget - UniBudget" description="Manage your monthly spending budget and rollover." />
  </head>
  <body class="auth-page workspace-page budgets-page">
    <WorkspaceLayout activePage="budgets">
      <main class="workspace-content budgets-content">
        <header class="budget-page-header">
          <div class="budget-page-intro">
            <p class="eyebrow">YOUR MONTHLY PLAN</p>
            <h1 id="page-title">Budgets</h1>
            <p class="page-description">A clear view of your spending plan, actual expenses and rollover.</p>
          </div>

          <nav class="month-navigation" aria-label="Budget month">
            {previousMonth
              ? <a class="month-control" href={`/budgets?month=${previousMonth}`} aria-label={`View previous month, ${previousMonth}`}><span aria-hidden="true">←</span><span class="month-control-label">Previous</span></a>
              : <span class="month-control disabled" role="link" aria-disabled="true" aria-label="Previous month unavailable"><span aria-hidden="true">←</span><span class="month-control-label">Previous</span></span>}
            <input
              id="budget-month-picker"
              class="month-picker"
              type="month"
              min="0001-01"
              max={todayMonth}
              value={month}
              aria-label="Select budget month"
            />
            {nextMonth
              ? <a class="month-control" href={`/budgets?month=${nextMonth}`} aria-label={`View next month, ${nextMonth}`}><span class="month-control-label">Next</span><span aria-hidden="true">→</span></a>
              : <span class="month-control disabled" role="link" aria-disabled="true" aria-label="Next month unavailable"><span class="month-control-label">Next</span><span aria-hidden="true">→</span></span>}
          </nav>
        </header>

        <p id="initial-month-error" class="budget-message is-error" role="status" hidden={!invalidMonthMessage}>
          {invalidMonthMessage}
        </p>

        <section class="budget-overview panel" aria-labelledby="budget-summary-heading">
          <div class="budget-section-heading">
            <div>
              <p class="section-kicker">MONTHLY OVERVIEW</p>
              <h2 id="budget-summary-heading">{displayMonth}</h2>
              <p class="panel-description">Eligible expenses across all categories through {reportThroughDate}.</p>
            </div>
            {month < todayMonth && <span class="history-label">Historical · read only</span>}
          </div>

          <p id="budget-load-status" class="budget-message" role="status" aria-live="polite">Loading your budget…</p>
          <div id="budget-list" class="budget-list" aria-live="polite"></div>

          <p class="rollover-explanation">
            <strong>Rollover is automatic.</strong>
            Unused budget adds to next month; overspending reduces it. Months without a base budget carry the balance forward, less eligible expenses.
          </p>
        </section>

        {month === todayMonth && (
          <section class="budget-form-panel panel" aria-labelledby="form-title">
            <div class="form-heading">
              <div>
                <p class="section-kicker">MONTHLY ALLOCATION</p>
                <h2 id="form-title">Set this month’s budget</h2>
                <p id="form-description" class="panel-description">Set one base amount for all eligible expenses this month.</p>
              </div>
              <button id="edit-budget-toggle" class="button-secondary edit-toggle" type="button" hidden aria-expanded="false" aria-controls="budget-form">
                Edit budget
              </button>
            </div>

            <form id="budget-form" class="budget-form" hidden>
              <div class="budget-fields">
                <div class="field-group">
                  <label for="budget-amount">Base monthly budget <span>{APP_CURRENCY}</span></label>
                  <div class="amount-input">
                    <span aria-hidden="true">€</span>
                    <input
                      id="budget-amount"
                      name="amount"
                      type="number"
                      min="0.01"
                      max="999999999999.99"
                      step="0.01"
                      inputmode="decimal"
                      placeholder="0.00"
                      required
                      aria-describedby="form-description budget-form-status"
                    />
                  </div>
                </div>
                <div class="form-actions">
                  <button id="cancel-budget-edit" class="button-secondary" type="button" hidden>Cancel</button>
                  <button id="submit-budget" class="button-primary" type="submit">
                    <span id="submit-budget-label">Set monthly budget</span>
                  </button>
                </div>
              </div>
              <p id="budget-form-status" class="budget-message" role="status" aria-live="polite"></p>
            </form>
          </section>
        )}
      </main>
    </WorkspaceLayout>
  </body>
</html>

<script>
  import { formatCurrencyAmount } from '../lib/currencyFormatting';

  interface Budget {
    id: string | null;
    month: string;
    hasBudget: boolean;
    baseBudget: string;
    openingRollover: string;
    availableBudget: string;
    eligibleExpenses: string;
    remainingBudget: string;
    closingRollover: string;
    spendingPercentage: string | null;
    status: 'under' | 'near' | 'over' | 'no-available' | 'negative-available' | 'unconfigured';
  }

  interface BudgetResponse {
    budget: Budget;
  }

  const budgetForm = document.querySelector<HTMLFormElement>('#budget-form');
  const monthPicker = document.querySelector<HTMLInputElement>('#budget-month-picker');
  const month = monthPicker?.value ?? '';
  const currentMonth = monthPicker?.max ?? month;
  const amountInput = document.querySelector<HTMLInputElement>('#budget-amount');
  const submitButton = document.querySelector<HTMLButtonElement>('#submit-budget');
  const submitLabel = document.querySelector<HTMLElement>('#submit-budget-label');
  const formStatus = document.querySelector<HTMLElement>('#budget-form-status');
  const loadStatus = document.querySelector<HTMLElement>('#budget-load-status');
  const budgetList = document.querySelector<HTMLElement>('#budget-list');
  const editToggle = document.querySelector<HTMLButtonElement>('#edit-budget-toggle');
  const cancelEdit = document.querySelector<HTMLButtonElement>('#cancel-budget-edit');
  let hasBudget = false;
  let originalBaseAmount = '';

  const statusCopy: Record<Budget['status'], string> = {
    under: 'Under budget',
    near: 'Near budget',
    over: 'Over budget',
    'no-available': 'No budget remaining',
    'negative-available': 'Overspent before this month',
    unconfigured: 'No budget set',
  };

  monthPicker?.addEventListener('change', () => {
    const selectedMonth = monthPicker.value;
    if (
      !/^\d{4}-(0[1-9]|1[0-2])$/.test(selectedMonth)
      || selectedMonth < '0001-01'
      || selectedMonth > currentMonth
    ) {
      monthPicker.value = month;
      return;
    }
    window.location.assign(`/budgets?month=${encodeURIComponent(selectedMonth)}`);
  });

  function addTextElement(parent: HTMLElement, tag: string, className: string, text: string): HTMLElement {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = text;
    parent.append(element);
    return element;
  }

  function formatMoney(value: string): string {
    return formatCurrencyAmount(value);
  }

  function createBudgetCard(budget: Budget): HTMLElement {
    const card = document.createElement('article');
    card.className = `budget-summary-card status-${budget.status}`;
    card.setAttribute('aria-labelledby', 'budget-summary-title');

    const header = document.createElement('div');
    header.className = 'budget-summary-heading';
    const title = document.createElement('div');
    addTextElement(title, 'p', 'budget-card-kicker', 'TOTAL MONTHLY BUDGET');
    addTextElement(title, 'h3', 'budget-card-title', 'Overall spending');
    title.querySelector('h3')?.setAttribute('id', 'budget-summary-title');
    header.append(title);
    const status = addTextElement(header, 'span', `budget-status ${budget.status}`, statusCopy[budget.status]);
    status.setAttribute('aria-label', `Budget status: ${statusCopy[budget.status]}`);
    card.append(header);

    const balance = document.createElement('div');
    balance.className = `budget-balance${budget.remainingBudget.startsWith('-') ? ' is-negative' : ''}`;
    addTextElement(balance, 'p', 'budget-balance-label', 'Remaining this month');
    const remaining = addTextElement(balance, 'p', 'budget-balance-value', formatMoney(budget.remainingBudget));
    remaining.setAttribute('aria-label', `Remaining budget ${formatMoney(budget.remainingBudget)}`);
    const balanceNote = budget.remainingBudget.startsWith('-')
      ? 'You have spent more than the available budget.'
      : budget.status === 'unconfigured'
        ? 'No base budget is set for this month.'
        : 'Available to spend after eligible expenses.';
    addTextElement(balance, 'p', 'budget-balance-note', balanceNote);
    card.append(balance);

    const figures = document.createElement('dl');
    figures.className = 'budget-metrics';
    const values: Array<[string, string]> = [
      ['Base budget', formatMoney(budget.baseBudget)],
      ['Opening rollover', formatMoney(budget.openingRollover)],
      ['Available budget', formatMoney(budget.availableBudget)],
      ['Eligible spending', formatMoney(budget.eligibleExpenses)],
    ];
    for (const [label, value] of values) {
      const item = document.createElement('div');
      item.className = 'budget-metric';
      addTextElement(item, 'dt', 'budget-metric-label', label);
      addTextElement(item, 'dd', 'budget-metric-value', value);
      figures.append(item);
    }
    card.append(figures);

    const progressSection = document.createElement('div');
    progressSection.className = 'budget-progress-section';
    const progressHeading = document.createElement('div');
    progressHeading.className = 'budget-progress-heading';
    addTextElement(progressHeading, 'span', 'budget-progress-caption', 'Spending progress');
    if (budget.spendingPercentage !== null) {
      const percent = Number(budget.spendingPercentage);
      addTextElement(progressHeading, 'span', 'budget-progress-value', `${budget.spendingPercentage}%`);
      const progress = document.createElement('progress');
      progress.className = `budget-progress ${budget.status}`;
      progress.max = 100;
      progress.value = Math.max(0, Math.min(100, percent));
      progress.setAttribute('aria-label', `Spending progress: ${budget.spendingPercentage}% of available budget used`);
      progress.setAttribute('aria-valuetext', `${budget.spendingPercentage}% spent`);
      progressSection.append(progressHeading, progress);
      const progressNote = percent > 100
        ? `${budget.spendingPercentage}% of the available budget used`
        : `${formatMoney(budget.eligibleExpenses)} spent of ${formatMoney(budget.availableBudget)} available`;
      addTextElement(progressSection, 'p', 'budget-progress-note', progressNote);
    } else {
      addTextElement(
        progressHeading,
        'p',
        'budget-progress-value',
        '—',
      );
      const note = budget.status === 'negative-available'
        ? 'Prior overspending has reduced the available budget below zero.'
        : budget.status === 'over'
          ? 'Spending exceeded the available amount, even though it is zero.'
          : budget.status === 'unconfigured'
            ? 'No positive base amount or rollover is available for this month.'
            : 'A spending percentage is unavailable when the available budget is zero.';
      addTextElement(progressSection, 'p', 'budget-progress-note', note);
    }
    card.append(progressSection);

    return card;
  }

  async function loadBudgets(): Promise<void> {
    if (!budgetList || !loadStatus) return;
    loadStatus.hidden = false;
    loadStatus.className = 'budget-message is-loading';
    loadStatus.textContent = 'Loading budget…';
    budgetList.replaceChildren();
    try {
      const response = await fetch(`/api/budgets?month=${encodeURIComponent(month)}`, {
        headers: { Accept: 'application/json' },
      });
      const result = await response.json() as BudgetResponse & { error?: string };
      if (!response.ok) throw new Error(result.error ?? 'Unable to load budget.');
      const budget = result.budget;
      budgetList.append(createBudgetCard(budget));
      if (month === currentMonth && budgetForm && amountInput && submitLabel && editToggle) {
        hasBudget = budget.hasBudget;
        if (budget.hasBudget) {
          amountInput.value = budget.baseBudget;
          originalBaseAmount = budget.baseBudget;
          budgetForm.hidden = true;
          editToggle.hidden = false;
          editToggle.setAttribute('aria-expanded', 'false');
          submitLabel.textContent = 'Save new amount';
          const formTitle = document.querySelector<HTMLElement>('#form-title');
          const formDescription = document.querySelector<HTMLElement>('#form-description');
          if (formTitle) formTitle.textContent = 'Edit this month’s budget';
          if (formDescription) {
            formDescription.textContent = 'Saving replaces the base amount. Existing spending and rollover are preserved.';
          }
        } else {
          budgetForm.hidden = false;
          editToggle.hidden = true;
          submitLabel.textContent = 'Set monthly budget';
        }
      }
      loadStatus.hidden = true;
    } catch (error) {
      loadStatus.hidden = false;
      loadStatus.className = 'budget-message is-error';
      loadStatus.textContent = error instanceof Error ? error.message : 'Unable to load budget.';
    }
  }

  editToggle?.addEventListener('click', () => {
    if (!budgetForm || !amountInput) return;
    budgetForm.hidden = false;
    editToggle.hidden = true;
    editToggle.setAttribute('aria-expanded', 'true');
    if (cancelEdit) cancelEdit.hidden = false;
    amountInput.focus();
  });

  cancelEdit?.addEventListener('click', () => {
    if (!budgetForm || !editToggle) return;
    budgetForm.hidden = true;
    editToggle.hidden = false;
    editToggle.setAttribute('aria-expanded', 'false');
    if (amountInput) amountInput.value = originalBaseAmount;
    cancelEdit.hidden = true;
    editToggle.focus();
  });

  budgetForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!amountInput || !submitButton || !submitLabel || !formStatus) return;
    submitButton.disabled = true;
    submitLabel.textContent = 'Saving…';
    formStatus.className = 'budget-message is-loading';
    formStatus.textContent = '';
    try {
      const wasEditing = hasBudget;
      const response = await fetch('/api/budgets', {
        method: wasEditing ? 'PATCH' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount: amountInput.value,
        }),
      });
      const result = await response.json() as { error?: string };
      if (!response.ok) throw new Error(result.error ?? 'Unable to save this budget.');
      hasBudget = true;
      formStatus.className = 'budget-message is-success';
      formStatus.textContent = wasEditing ? 'Budget updated.' : 'Budget created.';
      if (!wasEditing && editToggle && budgetForm) {
        originalBaseAmount = amountInput.value;
        budgetForm.hidden = true;
        editToggle.hidden = false;
        editToggle.setAttribute('aria-expanded', 'false');
        if (cancelEdit) cancelEdit.hidden = true;
      }
      await loadBudgets();
      if (editToggle && !editToggle.hidden) editToggle.focus();
    } catch (error) {
      formStatus.className = 'budget-message is-error';
      formStatus.textContent = error instanceof Error ? error.message : 'Unable to save this budget.';
    } finally {
      submitButton.disabled = false;
      submitLabel.textContent = hasBudget ? 'Save new amount' : 'Set monthly budget';
    }
  });

  void loadBudgets();
</script>

<style>
  .page-topbar {
    margin-bottom: 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .back-link svg {
    width: 17px;
    height: 17px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .back-link:hover,
  .back-link:active {
    color: var(--color-accent-hover);
  }

  .back-link:focus-visible {
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  .budget-management {
    padding: clamp(20px, 3vw, 34px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.045), transparent 44%),
      var(--glass-surface);
    box-shadow: var(--glass-shadow);
    -webkit-backdrop-filter: blur(var(--glass-blur));
    backdrop-filter: blur(var(--glass-blur));
  }

  .month-heading,
  .list-heading,
  .form-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .month-heading h2,
  .budget-form-wrap h3,
  .list-heading h3,
  .budget-card h4 {
    margin: 0 0 7px;
    color: var(--color-text-primary);
  }

  .month-heading h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.04em;
  }

  .panel-description {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
  }

  .rollover-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 26px;
    padding: 15px 17px;
    border: 1px solid rgba(104, 151, 255, 0.2);
    border-radius: var(--radius-md);
    background: rgba(104, 151, 255, 0.07);
  }

  .rollover-icon {
    display: grid;
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: rgba(104, 151, 255, 0.17);
    color: var(--color-accent-hover);
  }

  .rollover-note p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.81rem;
  }

  .rollover-note strong {
    color: var(--color-text-primary);
  }

  .budget-form-wrap {
    margin-top: 31px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-border);
  }

  .budget-form-wrap h3,
  .list-heading h3 {
    font-size: 1.03rem;
  }

  .form-heading {
    align-items: center;
  }

  .budget-form {
    margin-top: 17px;
  }

  .budget-fields {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto;
    align-items: end;
    gap: 14px;
  }

  .field-group {
    display: grid;
    gap: 7px;
  }

  .field-group label {
    color: var(--color-text-secondary);
    font-size: 0.77rem;
    font-weight: 600;
  }

  .field-group label span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .field-group input,
  .field-group select {
    box-sizing: border-box;
    width: 100%;
    min-height: 43px;
    padding: 10px 12px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-input);
    color: var(--color-text-primary);
    font: inherit;
    font-size: 0.85rem;
  }

  .amount-input {
    position: relative;
  }

  .amount-input > span {
    position: absolute;
    top: 50%;
    left: 12px;
    color: var(--color-text-muted);
    transform: translateY(-50%);
  }

  .amount-input input {
    padding-left: 29px;
  }

  .button-primary svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .form-status,
  .list-status {
    min-height: 1.3em;
    margin: 9px 0 0;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
  }

  .budget-list-section {
    margin-top: 27px;
  }

  .list-heading {
    margin-bottom: 17px;
  }

  .budget-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    max-width: 820px;
  }

  .budget-card {
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.04), transparent 50%),
      rgba(9, 15, 26, 0.46);
  }

  .budget-card-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .budget-card h4 {
    overflow-wrap: anywhere;
    font-size: 1rem;
  }

  .budget-status {
    flex: 0 0 auto;
    padding: 5px 8px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: 0.67rem;
    font-weight: 650;
    line-height: 1.2;
    text-align: center;
  }

  .budget-status.under {
    border-color: rgba(52, 211, 153, 0.28);
    background: rgba(52, 211, 153, 0.09);
    color: #6ee7b7;
  }

  .budget-status.near {
    border-color: rgba(251, 191, 36, 0.27);
    background: rgba(251, 191, 36, 0.08);
    color: #fcd34d;
  }

  .budget-status.over,
  .budget-status.negative-available {
    border-color: rgba(248, 113, 113, 0.27);
    background: rgba(248, 113, 113, 0.08);
    color: #fca5a5;
  }

  .budget-figures {
    display: grid;
    gap: 9px;
    margin: 19px 0 0;
  }

  .budget-figure {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--color-text-secondary);
    font-size: 0.78rem;
  }

  .budget-figure dt,
  .budget-figure dd {
    margin: 0;
  }

  .budget-figure dd {
    color: var(--color-text-primary);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .budget-figure .remaining-amount {
    font-weight: 700;
  }

  .budget-figure .amount-negative {
    color: #fca5a5;
  }

  .budget-progress-section {
